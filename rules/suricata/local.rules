# Собственные правила Suricata для стенда. SID 1000001+ (локальный диапазон).
# Только лабораторная сеть 192.168.56.0/24. Проверка: suricata -T -c /etc/suricata/suricata.yaml

# --- Горизонтальное/вертикальное сканирование портов ---
# Много SYN на разные порты одного хоста за короткое время.
alert tcp $HOME_NET any -> $HOME_NET any (msg:"LAB SCAN вертикальное сканирование портов (SYN)"; \
    flags:S,12; flow:to_server; \
    threshold:type both, track by_src, count 30, seconds 10; \
    classtype:attempted-recon; sid:1000001; rev:1;)

# Подключения к типовым «интересным» портам (потенциальная разведка сервисов)
alert tcp $HOME_NET any -> $HOME_NET [21,22,23,139,445,1433,3306,3389,5985] (msg:"LAB SCAN перебор типовых сервисных портов"; \
    flags:S; flow:to_server; \
    threshold:type both, track by_src, count 10, seconds 15; \
    classtype:attempted-recon; sid:1000002; rev:1;)

# --- Подбор пароля ---
# Много новых TCP-сессий к SSH за короткое время (brute force)
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"LAB BRUTE подбор SSH (частые подключения)"; \
    flow:to_server; flags:S; \
    threshold:type both, track by_src, count 15, seconds 30; \
    classtype:attempted-admin; sid:1000003; rev:1;)

# То же к RDP
alert tcp $HOME_NET any -> $HOME_NET 3389 (msg:"LAB BRUTE подбор RDP (частые подключения)"; \
    flow:to_server; flags:S; \
    threshold:type both, track by_src, count 15, seconds 30; \
    classtype:attempted-admin; sid:1000004; rev:1;)

# --- Веб-атаки на Juice Shop (пункт связки с прошлым проектом) ---
# Признаки SQL-инъекции в URI
alert http $HOME_NET any -> $HOME_NET any (msg:"LAB WEB признак SQL-инъекции в запросе"; \
    flow:to_server; http.uri; pcre:"/(union\s+select|' or '1'='1|sleep\(|information_schema)/i"; \
    classtype:web-application-attack; sid:1000010; rev:1;)
